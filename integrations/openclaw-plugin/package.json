{
  "name": "@dsa/openclaw-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A guarded OpenClaw sidebar and same-origin entry for the original DSA manual workbench",
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "files": [
    "dist/",
    "app/",
    "static/",
    "openclaw.plugin.json",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "plugin:build": "npm run build && openclaw plugins build --root .",
    "plugin:validate": "openclaw plugins validate --root . --json",
    "plugin:pack": "openclaw plugins pack --root . --json"
  }
}
